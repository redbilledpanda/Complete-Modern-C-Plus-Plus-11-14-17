{
    "version": 3,
    "configurePresets": [
      {
        "name": "linux-gcc",
        "displayName": "Linux GCC",
        "generator": "Unix Makefiles",
        "binaryDir": "${sourceDir}/build",
        "cacheVariables": {
          "CMAKE_C_COMPILER": "/usr/bin/gcc",
          "CMAKE_CXX_COMPILER": "/usr/bin/g++",
          "CMAKE_MAKE_PROGRAM": "/usr/bin/make"
        },
        "environment": {
          "PATH": "/usr/bin:${env:PATH}"
        }
      }
    ]
  }
  